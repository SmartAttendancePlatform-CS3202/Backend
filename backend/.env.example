# Copy this file to services/<service-name>/.env for each service —
# docker-compose reads each service's env from its own folder so you
# can point different services at different Supabase projects if
# you ever need to (e.g. a staging DB).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres
INTERNAL_API_KEY=change-me
